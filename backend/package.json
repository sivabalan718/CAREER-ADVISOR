{
  "name": "m63-backend",
  "version": "0.1.0",
  "private": true,
  "description": "M63 backend deployment workspace (shared -> engine -> server)",
  "workspaces": [
    "shared",
    "engine",
    "server"
  ],
  "scripts": {
    "build": "npm run build -w @m63/shared && npm run build -w @m63/engine && npm run build -w @m63/server && npm run bundle",
    "dev": "npm run dev -w @m63/server",
    "start": "npm run start -w @m63/server",
    "bundle": "esbuild index.ts --bundle --platform=node --format=cjs --target=node20 --external:express --outfile=deploy/index.js --log-level=warning --footer:js=\"module.exports = module.exports.default || module.exports;\""
  },
  "dependencies": {
    "@m63/server": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.25.0"
  }
}
