{
  "name": "m63-platform",
  "version": "0.1.0",
  "private": true,
  "description": "M63: Evidence-Driven Multi-Dimensional Career Decision Intelligence Platform",
  "workspaces": [
    "frontend",
    "backend",
    "engine",
    "shared"
  ],
  "scripts": {
    "build:shared": "npm run --workspace=@m63/shared build",
    "build:engine": "npm run --workspace=@m63/engine build",
    "build:backend": "npm run --workspace=@m63/server build",
    "build:frontend": "npm run --workspace=@m63/client build",
    "build": "npm run build:shared && npm run build:engine && npm run build:backend && npm run build:frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"Lint check completed\"",
    "dev:server": "npm run --workspace=@m63/server dev",
    "dev:client": "npm run --workspace=@m63/client dev",
    "dev": "echo \"Run dev:server and dev:client\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
