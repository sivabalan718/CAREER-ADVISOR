# M63 Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL VALUES. NEVER COMMIT REAL CREDENTIALS.

# Application Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Real-World Market & Opportunity Providers
PROVIDER_TIMEOUT_MS=8000

# Adzuna API (primary job/market evidence provider) — SERVER-SIDE ONLY
# Free developer keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DEFAULT_COUNTRY=in

# Evidence cache & freshness policy (seconds)
EVIDENCE_CACHE_TTL_JOBS_SEC=3600
EVIDENCE_CACHE_TTL_MARKET_SEC=86400
EVIDENCE_CACHE_TTL_STRUCTURAL_SEC=604800

# Supabase — SERVER-SIDE service role (used only for market snapshots). NEVER expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional LLM communicator for M63 AI (grounded explanations only). Leave empty to use the
# deterministic grounded explainer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

LOG_LEVEL=info

# Gemini (prefegit push -u origin main
rred LLM communicator). Comma-separated models are tried in order.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest

# Set true later to require email confirmation on sign-up
REQUIRE_EMAIL_VERIFICATION=false
